//// Constants (applicable to NEO-M8N)
//baud rate 115200 bps (CFG-PRT)
const uint8_t set115200[] = {
  0xB5, 0x62, 0x06, 0x00, 0x14, 0x00, 0x01, 0x00, 0x00, 0x00, 
  0xD0, 0x08, 0x00, 0x00, 0x00, 0xC2, 0x01, 0x00, 0x03, 0x00, 
  0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0xBC, 0x5E
};

//update rate (CFG-RATE)
const uint8_t set1Hz[]  = {0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0xE8, 0x03, 0x01, 0x00, 0x01, 0x00, 0x01, 0x39};
const uint8_t set5Hz[]  = {0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0xC8, 0x00, 0x01, 0x00, 0x01, 0x00, 0xDE, 0x6A};
const uint8_t set10Hz[] = {0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0x64, 0x00, 0x01, 0x00, 0x01, 0x00, 0x7A, 0x12};

//NMEA sentence (CFG-MSG)
const uint8_t enableGGA[]  = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x28};
const uint8_t enableRMC[]  = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x04, 0x44};
const uint8_t disableGGA[] = {0xB5, 0x62, 0x06, 0x01, 0x03, 0x00, 0xF0, 0x00, 0x00, 0xFA, 0x0F};
const uint8_t disableGLL[] = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2A}; 
const uint8_t disableGSA[] = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x31}; 
const uint8_t disableGSV[] = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x38}; 
const uint8_t disableVTG[] = {0xB5, 0x62, 0x06, 0x01, 0x08, 0x00, 0xF0, 0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x46}; 


//// Gps setup
void  init_gps() {
  uint32_t baudrates[] = {9600, 38400, 115200};

  for (int i=0;i<3;i++) {
    gpsSerial.begin(baudrates[i], SERIAL_8N1, RX_GPS, TX_GPS);
    delay(200);
    gpsSerial.write(set115200, sizeof(set115200));
    gpsSerial.flush();
    delay(200);
    gpsSerial.end();
  }

  gpsSerial.setRxBufferSize(1024);        //may not be needed
  gpsSerial.begin(115200, SERIAL_8N1, RX_GPS, TX_GPS);
  delay(500);

  gpsSerial.write(set1Hz, sizeof(set1Hz));         delay(100);
  gpsSerial.write(disableGGA, sizeof(disableGGA)); delay(100);
  gpsSerial.write(enableRMC,  sizeof(enableRMC));  delay(100);
  gpsSerial.write(disableGLL, sizeof(disableGLL)); delay(100);
  gpsSerial.write(disableGSA, sizeof(disableGSA)); delay(100);
  gpsSerial.write(disableGSV, sizeof(disableGSV)); delay(100);
  gpsSerial.write(disableVTG, sizeof(disableVTG)); delay(100);
}


